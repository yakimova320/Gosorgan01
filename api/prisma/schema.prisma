// Схема базы Ja!sno. Источник: ТЗ v2 раздел 7 с изменениями ТЗ v4 раздел 8.
// База только PostgreSQL (TechBriefing v5, раздел 3).
// Простыми словами о таблицах: docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum CaseOrigin {
  INCOMING
  OUTGOING
}

enum SourceType {
  PDF_TEXT
  IMAGE
  PDF_SCAN // B11: PDF, где хотя бы одна страница без текстового слоя распознана как изображение
}

enum ClaimKind {
  AUTHORITY
  CASE_NUMBER
  LETTER_DATE
  REQUIREMENT
  DEADLINE
  AMOUNT
  OTHER
}

enum ClaimBasis {
  DOCUMENT
  USER
}

enum ClaimStatus {
  UNCONFIRMED
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum DeadlineKind {
  REPLY
  DOCUMENTS
  OBJECTION
  FOLLOW_UP
}

enum MessageKind {
  QUESTION
  STATEMENT
  ANSWER
}

enum DraftKind {
  CLARIFICATION
  DOCUMENTS
  EXTENSION
  STATUS_REQUEST
  TEMPLATE
  FREE
}

enum DraftStatus {
  PREPARED
  SENT
}

enum EventType {
  LETTER_RECEIVED
  CASE_CREATED_FROM_LETTER
  CLAIM_CONFIRMED
  CLAIM_REJECTED
  QUESTION_ASKED
  USER_REPORTED_SENT
  DRAFT_PREPARED
  DRAFT_SENT
  DEADLINE_DONE
  REVISION
}

model Cabinet {
  id                  String               @id @default(cuid())
  email               String               @unique // в нижнем регистре
  passwordHash        String
  passwordChangedAt   DateTime? // ТЗ v4: после смены пароля старые сессии недействительны
  language            String               @default("ru")
  profile             Json? // { firstName, lastName, address, street?, postalCode?, city?, numbers: [{label, value}] }
  // Поправка 9 (23.11): копия имени и фамилии из profile отдельными столбцами — их видно в таблице Supabase.
  // Источник правды — profile; столбцы обновляются при регистрации и изменении профиля.
  firstName           String?
  lastName            String?
  consentAt           DateTime
  // K11 (#134): отдельное согласие на анализ текста письма ИИ (DSGVO). null — не дано или отозвано.
  // Версия — версия текста согласия (AI_CONSENT_VERSION в packages/shared); старая версия = нет согласия.
  aiConsentAt         DateTime?
  aiConsentVersion    Int?
  createdAt           DateTime             @default(now())
  lastSeenAt          DateTime             @default(now())
  // A01: временная блокировка записей на время удаления аккаунта. Не мягкое удаление:
  // после успешного удаления строки кабинета нет; при откате отметка снимается.
  deletingAt          DateTime?
  // B19: демо-кабинет из pnpm db:seed. Только такой кабинет seed может пересоздать;
  // обычный аккаунт с тем же e-mail не трогается. Через API не меняется.
  demo                Boolean              @default(false)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  passwordResetMails  PasswordResetMail[]
  llmOperations       LlmOperation[]
  cases               Case[]
  letters             Letter[]
}

model Session {
  id         String   @id @default(cuid())
  cabinetId  String
  cabinet    Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // sha256 от токена, сам токен не хранится
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // A02: момент пароля, которым подтверждена сессия (вход или смена пароля).
  // Сессия действительна, только если passwordAt >= Cabinet.passwordChangedAt.
  passwordAt DateTime @default(now())

  @@index([cabinetId])
}

// ТЗ v4: ссылка восстановления пароля. Сам токен не хранится, только sha256.
model PasswordResetToken {
  id        String    @id @default(cuid())
  cabinetId String
  cabinet   Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([cabinetId])
}

// A03: задание отправки письма восстановления (outbox). Секрета не хранит: токен создаётся
// при отправке, здесь только его id. Строки остаются после сброса и смены пароля, по ним считается
// лимит «3 письма в час на адрес»; старые строки удаляет фоновая очистка. Удаление кабинета удаляет их каскадом.
enum ResetMailStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model PasswordResetMail {
  id            String          @id @default(cuid())
  cabinetId     String
  cabinet       Cabinet         @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  status        ResetMailStatus @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  leaseUntil    DateTime?
  leaseOwner    String?
  tokenId       String? // токен последней попытки (без секрета)
  lastError     String? // только код ошибки, без адреса и ссылки
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([cabinetId, createdAt])
  @@index([status, nextAttemptAt])
}

model Case {
  id         String     @id @default(cuid())
  cabinetId  String
  cabinet    Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  title      String
  authority  String?
  caseNumber String?
  status     CaseStatus @default(OPEN)
  origin     CaseOrigin @default(INCOMING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  letters    Letter[]
  claims     Claim[]
  deadlines  Deadline[]
  events     Event[]
  messages   Message[]
  drafts     Draft[]

  @@index([cabinetId])
}

model Letter {
  id          String     @id @default(cuid())
  cabinetId   String
  cabinet     Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  caseId      String? // null = во входящих
  case        Case?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceType  SourceType
  rawText     String // распознанный текст, исходный, без маскирования
  pages       Json // [{ n, readable, chars }]
  files       Json // ТЗ v4: оригиналы [{ n, fileKey, mime, bytes }] в порядке страниц (B11: до 10 фото или один PDF), fileKey случайный, без имени файла
  explanation Json? // кэш объяснения; сбрасывается при любом изменении фактов письма
  title       String? // поправка 8 (23.11): название письма; предлагает модель по цитате (extract.v3), человек может изменить
  translation Json? // поправка 7 (23.11): кэш машинного перевода на русский { lang, promptVersion, textHash, text }
  createdAt   DateTime   @default(now())
  claims      Claim[]
  deadlines   Deadline[]

  @@index([cabinetId])
  @@index([caseId])
}

model Claim {
  id           String      @id @default(cuid())
  letterId     String?
  letter       Letter?     @relation(fields: [letterId], references: [id], onDelete: Cascade)
  caseId       String?
  case         Case?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind         ClaimKind
  value        String // нормализованное значение, дата в ISO 8601
  text         String // формулировка для человека по-русски
  quote        String? // точная цитата из письма; у USER может не быть
  page         Int?
  basis        ClaimBasis
  status       ClaimStatus @default(UNCONFIRMED)
  reason       String? // почему SUPERSEDED или REJECTED
  // ТЗ v4: исправление создаёт новую запись, она ссылается на предыдущую; старая получает SUPERSEDED
  supersedesId String?
  supersedes   Claim?      @relation("ClaimRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Claim[]     @relation("ClaimRevision")
  updatedBy    String? // USER или SYSTEM
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deadline     Deadline?

  @@index([letterId])
  @@index([caseId])
}

model Deadline {
  id               String       @id @default(cuid())
  letterId         String
  letter           Letter       @relation(fields: [letterId], references: [id], onDelete: Cascade)
  caseId           String?
  case             Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claimId          String       @unique
  claim            Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade) // ТЗ v4
  date             DateTime // календарная дата: полночь UTC, без сдвига часового пояса
  kind             DeadlineKind
  doneAt           DateTime?
  remindDaysBefore Int          @default(3)

  @@index([letterId])
  @@index([caseId])
}

model Event {
  id      String    @id @default(cuid())
  caseId  String
  case    Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type    EventType
  at      DateTime  @default(now())
  details Json

  @@index([caseId])
}

model Message {
  id        String      @id @default(cuid())
  caseId    String
  case      Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role      String // USER или ASSISTANT
  kind      MessageKind
  text      String
  createdAt DateTime    @default(now())

  @@index([caseId])
}

model Draft {
  id            String      @id @default(cuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind          DraftKind
  templateId    String?
  germanText    String
  russianText   String
  claimIds      Json
  claimSnapshot Json // ТЗ v4: значения фактов на момент сборки
  stale         Boolean     @default(false) // ТЗ v4: факт изменился после сборки
  verification  Json // отчёт проверки
  status        DraftStatus @default(PREPARED)
  sentAt        DateTime?
  sentVia       String?
  createdAt     DateTime    @default(now())

  @@index([caseId])
}

// Журнал обращений к модели. Без внешних ключей, чтобы не мешать удалению:
// строки удаляются кодом по cabinetId, caseId или letterId.
// Чат-помощник для гостя: cabinetId = null, input только первые 200 знаков, замаскированные.
model LlmCall {
  id            String   @id @default(cuid())
  cabinetId     String?
  letterId      String?
  caseId        String?
  promptName    String
  promptVersion Int
  provider      String
  model         String
  input         String // уже замаскированный текст; для фото только описание «image, N KB»
  output        String?
  ok            Boolean
  error         String?
  attempts      Int
  durationMs    Int
  tokensIn      Int?
  tokensOut     Int?
  operationId   String? // B18: операция пользователя (LlmOperation); фото = transcribe + extract с одним id
  createdAt     DateTime @default(now())

  @@index([cabinetId])
  @@index([letterId])
  @@index([caseId])
}

// B18: операция с моделью (загрузка письма или объяснение). Резервируется под блокировкой кабинета
// до первого обращения к модели; по этим строкам считается лимит LLM_DAILY_OPS_PER_CABINET за 24 часа.
// Удаляется вместе с кабинетом (A01).
enum LlmOperationKind {
  UPLOAD
  EXPLAIN
  TRANSLATE
  OTHER
}

model LlmOperation {
  id        String           @id @default(cuid())
  cabinetId String
  cabinet   Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  kind      LlmOperationKind
  createdAt DateTime         @default(now())

  @@index([cabinetId, createdAt])
}

// B18: общий учёт расхода модели по часам, без пользовательских данных. Не удаляется вместе с письмом
// или аккаунтом, поэтому удаление журнала LlmCall не возвращает потраченное в дневной бюджет.
model LlmUsageHour {
  hour              DateTime // начало часа (UTC)
  provider          String
  calls             Int      @default(0) // обращений к модели (попыток)
  failedCalls       Int      @default(0) // обращение не дало ответа (ошибка связи, квота, ключ)
  tokensIn          Int      @default(0)
  tokensOut         Int      @default(0)
  callsWithoutUsage Int      @default(0) // ответ пришёл без данных о токенах
  estimatedTokens   Int      @default(0) // оценка для таких ответов: не ноль, а по длине входа и выхода

  @@id([hour, provider])
}

enum ErasureStatus {
  PREPARING // блокировка поставлена, файлы ещё на месте (или перенос мог не записаться)
  FILES_MOVED // файлы в корзине storage/trash/<id>
  DB_DELETED // строки кабинета удалены, осталась окончательная очистка
  RESTORING // база не удалилась: файлы возвращаются, блокировка ещё стоит
}

// A01: задание удаления аккаунта. Без внешнего ключа: переживает удаление кабинета.
// Одно задание на кабинет. После успешной очистки строка удаляется целиком.
// lastError: только этап и тип ошибки, без путей и персональных данных.
model AccountErasure {
  id          String        @id @default(cuid())
  cabinetId   String        @unique
  status      ErasureStatus @default(PREPARING)
  attempts    Int           @default(0)
  lastError   String?
  leaseUntil  DateTime?
  leaseOwner  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
