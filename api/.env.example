# Скопируйте этот файл в api/.env и впишите значения. Файл .env в git не попадает.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://jasno:jasno@localhost:5432/jasno
# Доверенный прокси перед API (nginx, Caddy): loopback, адрес или подсеть, число шагов. Пусто: прокси нет.
TRUST_PROXY=
# Адрес сайта. Несколько адресов через запятую.
CORS_ORIGIN=http://localhost:5173

# demo: без настоящей модели (тесты, офлайн). openai: настоящая модель через OpenAI-совместимый API.
LLM_MODE=demo
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_ASSISTANT=
LLM_TIMEOUT_MS=60000

STORAGE_DIR=./storage
SESSION_TTL_DAYS=30
CABINET_TTL_DAYS=90

# Восстановление пароля. file: письмо сохраняется в storage/mail-outbox/<id кабинета>/ (только для разработки,
# в production запрещено). smtp: настоящая отправка, нужны SMTP_HOST и обычно SMTP_USER/SMTP_PASS.
# SMTP_SECURE=true для порта 465.
APP_PUBLIC_URL=http://localhost:5173
MAIL_MODE=file
MAIL_FROM=Ja!sno <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESET_TOKEN_TTL_MIN=60
SUPPORT_EMAIL=

UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_LETTER_MB=20
UPLOAD_MAX_FILES=10
