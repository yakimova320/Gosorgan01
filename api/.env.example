# Скопируйте этот файл в api/.env и впишите значения. Файл .env в git не попадает.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://jasno:jasno@localhost:5432/jasno
# Supabase (DB01-S, docs/deploy.md раздел 4): Session pooler, своя схема, проверка сертификата, малый пул.
#DATABASE_URL=postgresql://postgres.<id проекта>:<пароль>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=jasno&sslmode=require&sslcert=certs/supabase-ca.crt&sslaccept=strict&connection_limit=5
# Тесты и eval — только локальная база. Обязательно, если DATABASE_URL указывает на Supabase.
#TEST_DATABASE_URL=postgresql://jasno:jasno@localhost:5432/jasno
# Доверенный прокси перед API (nginx, Caddy): loopback, linklocal, uniquelocal, IP или подсеть через запятую.
# Число шагов и true не принимаются. Пусто: прокси нет, X-Forwarded-For не учитывается.
TRUST_PROXY=
# Лимиты по IP (вход, регистрация, «Забыли пароль?», загрузка письма). false только для тестов.
RATE_LIMIT_IP=true
# Адрес сайта. Несколько адресов через запятую.
CORS_ORIGIN=http://localhost:5173

# for Test on Phone:
#HOST=0.0.0.0
#CORS_ORIGIN=http://localhost:5173,http://192.168.2.104:5173
#APP_PUBLIC_URL=http://192.168.2.104:5173

# demo: без настоящей модели (тесты, офлайн). openai: настоящая модель через OpenAI-совместимый API.
LLM_MODE=demo
#LLM_MODE=openai
# Gemini или Anthropic (https://api.anthropic.com/v1/): для Anthropic адаптер не отправляет
# response_format и temperature, этот адрес их не принимает (HTTP 400).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_ASSISTANT=
# L05: векторы для вопросов к архиву писем.
#   local (по умолчанию): без модели и без сети, работает с любым провайдером (у Anthropic нет /embeddings);
#         вопрос сначала переводится моделью в немецкие слова писем (промпт archive-query).
#   api: OpenAI-совместимый /embeddings, например Gemini (бесплатная gemini-embedding-001).
#        Адрес и ключ: LLM_EMBED_BASE_URL и LLM_EMBED_API_KEY, иначе LLM_BASE_URL и LLM_API_KEY.
LLM_EMBED_MODE=local
#LLM_EMBED_MODEL=gemini-embedding-001
#LLM_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_EMBED_API_KEY=
LLM_TIMEOUT_MS=60000

STORAGE_DIR=./storage
# ST01: оригиналы писем. local: папка STORAGE_DIR/letters. s3: закрытый бакет Supabase Storage (docs/deploy.md раздел 5).
# Ключи — секрет, только здесь. Письма сброса пароля всегда в STORAGE_DIR.
STORAGE_MODE=local
#STORAGE_MODE=s3
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Папка собранного сайта: API отдаёт и сайт (так в Docker, B13). Пусто при pnpm dev.
WEB_DIST_DIR=
SESSION_TTL_DAYS=30
CABINET_TTL_DAYS=360

# Восстановление пароля. file: письмо сохраняется в storage/mail-outbox/<id кабинета>/ (только для разработки,
# в production запрещено). smtp: настоящая отправка, нужны SMTP_HOST и обычно SMTP_USER/SMTP_PASS.
# SMTP_SECURE=true для порта 465.
APP_PUBLIC_URL=http://localhost:5173
MAIL_MODE=file
MAIL_FROM=Ja!sno <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESET_TOKEN_TTL_MIN=60
# K12: напоминание о сроке по e-mail за 3 дня (проход раз в 15 минут, с 8 до 21 по Берлину). false — выключено.
REMINDERS_ENABLED=true
SUPPORT_EMAIL=

# Лимиты модели (B18). Операций (загрузка письма, объяснение) на кабинет за скользящие 24 часа; 0 — без лимита.
LLM_DAILY_OPS_PER_CABINET=30
# Чат-помощник: сообщений в чат на кабинет за 24 часа (отдельно от писем); 0 — без лимита.
LLM_DAILY_CHAT_PER_CABINET=50
# Мягкий общий порог токенов за 24 часа для всех кабинетов; 0 — выключен. Пример: 2000000.
LLM_DAILY_TOKEN_BUDGET=0

UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_LETTER_MB=20
UPLOAD_MAX_FILES=10

# Демо-кабинет (pnpm db:seed, B19). Пароль только здесь, в git не попадает: впишите свой, не меньше 10 знаков.
DEMO_EMAIL=demo@example.org
DEMO_PASSWORD=
