{
  "info": {
    "name": "Ja!sno API",
    "description": "Коллекция для проверки API Ja!sno. Каждая задача бэкенда добавляет свою папку. Окружение: local.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Здоровье",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok = true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('llmMode demo или openai', () => pm.expect(['demo', 'openai']).to.include(body.llmMode));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nope (неизвестный адрес)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nope"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 404', () => pm.response.to.have.status(404));",
                  "pm.test('code NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));",
                  "pm.test('message по-русски', () => pm.expect(pm.response.json().message).to.match(/[а-яА-Я]/));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Регистрация и вход",
      "description": "B03. Каждый запуск создаёт новый тестовый адрес postman-<время>@example.org. Запросы идут по порядку: токен сохраняется в переменную sessionToken.",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"consent\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', `postman-${Date.now()}@example.org`);",
                  "pm.collectionVariables.set('testPassword', 'postman-Passwort-123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json().sessionToken;",
                  "pm.test('есть sessionToken', () => pm.expect(t).to.be.a('string').with.lengthOf(43));",
                  "pm.collectionVariables.set('sessionToken', t);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register: e-mail занят",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"consent\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 409', () => pm.response.to.have.status(409));",
                  "pm.test('code EMAIL_TAKEN', () => pm.expect(pm.response.json().code).to.eql('EMAIL_TAKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register: без согласия",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-consent@example.org\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 400', () => pm.response.to.have.status(400));",
                  "pm.test('code CONSENT_REQUIRED', () => pm.expect(pm.response.json().code).to.eql('CONSENT_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register: пароль больше 72 байт",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"too-long@example.org\",\n  \"password\": \"яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя\",\n  \"consent\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 400', () => pm.response.to.have.status(400));",
                  "pm.test('code PASSWORD_TOO_LONG', () => pm.expect(pm.response.json().code).to.eql('PASSWORD_TOO_LONG'));",
                  "pm.test('ошибка у поля password', () => pm.expect(pm.response.json().details.fields).to.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cabinet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cabinet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cabinet"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('свой e-mail', () => pm.expect(b.email).to.eql(pm.collectionVariables.get('testEmail')));",
                  "pm.test('счётчики', () => pm.expect(b.counts).to.have.keys('openTasks', 'activeCases', 'inboxLetters'));",
                  "pm.test('нет пароля и хэша', () => pm.expect(JSON.stringify(b)).not.to.match(/password|hash/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /cabinet",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cabinet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cabinet"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"firstName\": \"Anna\",\n    \"numbers\": [\n      {\n        \"label\": \"Kundennummer\",\n        \"value\": \"123A456\"\n      }\n    ]\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('профиль сохранён', () => pm.expect(pm.response.json().profile.firstName).to.eql('Anna'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login: неверный пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"falsches-Passwort\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 401', () => pm.response.to.have.status(401));",
                  "pm.test('code INVALID_CREDENTIALS', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cabinet после выхода",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cabinet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cabinet"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 401', () => pm.response.to.have.status(401));",
                  "pm.test('code UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().sessionToken;",
                  "pm.test('новый токен', () => pm.expect(t).to.be.a('string').with.lengthOf(43));",
                  "pm.collectionVariables.set('sessionToken', t);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cabinet после входа",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cabinet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cabinet"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": ""
    },
    {
      "key": "sessionToken",
      "value": ""
    }
  ]
}
