{
  "name": "jasno-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsc -p tsconfig.build.json && node dist/scripts/seed.js",
    "llm:check": "tsc -p tsconfig.build.json && node dist/scripts/llm-check.js",
    "llm:check:photo": "tsc -p tsconfig.build.json && node dist/scripts/transcribe-check.js",
    "llm:check:extract": "tsc -p tsconfig.build.json && node dist/scripts/extract-check.js",
    "llm:check:explain": "tsc -p tsconfig.build.json && node dist/scripts/explain-check.js",
    "db:wipe-accounts": "tsc -p tsconfig.build.json && node dist/scripts/wipe-accounts.js",
    "eval": "tsc -p tsconfig.build.json && node dist/scripts/eval.js"
  },
  "dependencies": {
    "@jasno/shared": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "multer": "^2.5.0",
    "nodemailer": "10.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
