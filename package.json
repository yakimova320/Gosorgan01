{
  "name": "jasno",
  "version": "0.1.0",
  "private": true,
  "description": "Ja!sno: помощник для писем немецких ведомств",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "pnpm --filter jasno-api dev",
    "dev:web": "pnpm --filter jasno-web dev",
    "build": "pnpm --filter @jasno/shared build && pnpm --filter jasno-api build && pnpm --filter jasno-web build",
    "build:api": "pnpm --filter jasno-api build",
    "build:web": "pnpm --filter jasno-web build",
    "lint": "eslint api/src api/test web/src packages/shared/src",
    "format": "prettier --write \"api/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter jasno-api test:e2e && pnpm --filter jasno-web test:e2e",
    "db:migrate": "pnpm --filter jasno-api db:migrate",
    "db:studio": "pnpm --filter jasno-api db:studio",
    "db:seed": "pnpm --filter jasno-api db:seed",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "llm:check": "pnpm --filter jasno-api llm:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
